[Unit]
Description=Alienware Alpha LED and HDMI control
Requires=alphactld.socket
After=alphactld.socket systemd-modules-load.service
ConditionPathIsDirectory=/sys/devices/platform/alienware-wmi

[Service]
ExecStart=/usr/bin/alphactld
User=root
Group=root
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/sys
ReadWritePaths=/sys/devices/platform/alienware-wmi/rgb_zones/zone00
ReadWritePaths=/sys/devices/platform/alienware-wmi/rgb_zones/zone01
ReadWritePaths=/sys/devices/platform/alienware-wmi/rgb_zones/lighting_control_state
ReadWritePaths=/sys/devices/platform/alienware-wmi/hdmi/source
ReadWritePaths=/sys/devices/platform/alienware-wmi/leds/alienware::global_brightness/brightness
